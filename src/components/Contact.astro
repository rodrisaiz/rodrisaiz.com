---
import githubIcon from '../../public/logos/github.svg?raw';

const linkedinIcon = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`;

const linktreeIcon = `<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>Linktree</title><path d="m13.73635 5.85251 4.00467 -4.11665 2.3248 2.3808 -4.20064 4.00466h5.9085v3.30473h-5.9365l4.22865 4.10766 -2.3248 2.3338L12.0005 12.099l-5.74052 5.76852 -2.3248 -2.3248 4.22864 -4.10766h-5.9375V8.12132h5.9085L3.93417 4.11666l2.3248 -2.3808 4.00468 4.11665V0h3.4727zm-3.4727 10.30614h3.4727V24h-3.4727z"></path></svg>`;
---

<section class="contact" id="contact">
  <div class="contact-card">
    <div class="contact-intro">
      <h2 class="contact-heading">Let's talk.</h2>

      <p class="contact-body">
        Have a project in mind, an opportunity to discuss, or just want to
        say hi? My inbox is open.
      </p>

      <ul class="contact-social">
        <li>
          <a
            href="https://github.com/rodrisaiz"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            set:html={githubIcon}
          />
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/rodrisaiz/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            set:html={linkedinIcon}
          />
        </li>
        <li>
          <a
            href="https://linktr.ee/rodrisaiz"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Linktree"
            set:html={linktreeIcon}
          />
        </li>
      </ul>
    </div>

    <form
      class="contact-form"
      id="contact-form"
      method="post"
      enctype="text/plain"
    >
      <div class="contact-form-section">
        <label for="fullname" class="contact-form-label">Full name</label>
        <input
          class="contact-form-input"
          type="text"
          name="fullname"
          id="fullname"
          placeholder="e.g. Jane Doe"
          required
        />
      </div>

      <div class="contact-form-section">
        <label for="email" class="contact-form-label">Email</label>
        <input
          class="contact-form-input"
          type="email"
          name="email"
          id="email"
          placeholder="e.g. jane@example.com"
          required
        />
      </div>

      <div class="contact-form-section">
        <label for="message" class="contact-form-label">Message</label>
        <textarea
          class="contact-form-input"
          name="message"
          id="message"
          rows="4"
          placeholder="Hi there!..."
          required
        ></textarea>
      </div>

      <button type="submit" class="contact-form-btn">Send message</button>
    </form>
  </div>
</section>

<script>
  // Assembled at runtime so the address isn't plain text in the HTML source.
  const form = document.getElementById('contact-form');
  const user = ['r', 'o', 'd', 'r', 'i', 's', 'a', 'i', 'z'].join('');
  const domain = ['i', 'c', 'l', 'o', 'u', 'd', '.', 'c', 'o', 'm'].join('');

  if (form instanceof HTMLFormElement) {
    form.action = `mailto:${user}@${domain}`;
  }
</script>

<style>
  .contact-card {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);

    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: 24px;

    background: rgba(99, 99, 99, 0.12);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .contact-intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .contact-heading {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;

    margin-bottom: 1rem;
  }

  .contact-body {
    max-width: 42ch;

    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-muted);

    margin-bottom: 2rem;
  }

  .contact-social {
    display: flex;
    gap: 0.75rem;

    list-style: none;
  }

  .contact-social a {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 2.75rem;
    height: 2.75rem;

    border-radius: 50%;
    border: 1px solid var(--border);

    color: var(--text);
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  .contact-social a:hover {
    color: var(--primary);
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .contact-social :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-form-label {
    display: block;

    font-size: 0.875rem;
    color: var(--text-muted);

    margin-bottom: 0.5rem;
  }

  .contact-form-input {
    width: 100%;

    padding: 0.875rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);

    background: rgba(0, 0, 0, 0.35);
    color: var(--text);

    font-family: inherit;
    font-size: 0.9375rem;

    resize: vertical;

    transition: border-color 0.25s ease;
  }

  .contact-form-input:focus {
    outline: none;
    border-color: var(--primary);
  }

  .contact-form-input::placeholder {
    color: var(--text-muted);
    opacity: 0.7;
  }

  .contact-form-btn {
    align-self: flex-start;

    padding: 0.875rem 1.75rem;
    border-radius: 10px;
    border: none;

    background: #fff;
    color: #04121c;

    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 600;

    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  .contact-form-btn:hover {
    background: var(--primary);
    color: #04121c;
    transform: translateY(-2px);
  }

  @media (max-width: 800px) {
    .contact-card {
      grid-template-columns: 1fr;
    }

    .contact-form-btn {
      align-self: stretch;
    }
  }
</style>
