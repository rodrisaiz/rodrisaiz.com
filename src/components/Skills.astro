---
import Carousel from './Carousel.astro';
import { logos } from '../assets/data/logos.js';

interface SkillItem {
  icon: string;
  title: string;
  description: string;
  tags?: string[];
}

interface Props {
  skills: SkillItem[];
}

const { skills } = Astro.props as Props;
---

<section class="skills-section">
  <div class="container">

    <div class="carousel-wrapper">
      <Carousel tools={logos} />
    </div>

    <div class="skills-grid">
      {skills.map((skill) => {
        const tags = skill.tags ?? [];

        return (
          <div class="skill-card">
            <div class="skill-content">

              <div
                class="skill-icon"
                style="background: rgba(var(--accent-rgb), 0.08);"
                set:html={skill.icon}
              />

              <h3 class="skill-title">{skill.title}</h3>

              <p class="skill-description">
                {skill.description}
              </p>

              {tags.length > 0 && (
                <div class="card-tags">
                  {tags.map((tag) => (
                    <span class="card-tag">{tag}</span>
                  ))}
                </div>
              )}

            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>


<style>

  
.skills-section {
  width: 100%;
  padding: 4rem 0;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1rem;
}

/* GRID */
.skills-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

/* CARD */
.skill-card {
  padding: 1.5rem 1.75rem;
  
  background: rgba(99, 99, 99, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  
  transition: all 0.25s ease;
}

.skill-card:hover {
  transform: translateY(-4px);
  background: rgba(99, 99, 99, 0.28);
  border-color: rgba(255, 255, 255, 0.18);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

/* CONTENT LAYOUT */
.skill-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  height: 100%;
}

/* ICON */
.skill-icon {
  width: 48px;
  height: 48px;
  
  display: flex;
  align-items: center;
  justify-content: center;
  
  border-radius: 12px;
  
  margin-bottom: 1rem;
  
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.skill-card:hover .skill-icon {
  transform: scale(1.1);
}

/* SVG */
.skill-icon :global(svg) {
  width: 40px;
  height: 40px;
}

/* TEXT */
.skill-title {
  margin-bottom: 0.5rem;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-foreground);
}

.skill-description {
  max-width: 65ch;
  line-height: 1.7;
  color: var(--color-text-muted);
}

/* TAGS (BOTTOM PUSH) */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  
  margin-top: auto;
  padding-top: 2rem;
}

.card-tag {
  padding: 0.35rem 0.65rem;
  border-radius: 999px;

  background: #ebebeb1d;
  color: #e5e7eb;
  
  font-size: 0.75rem;
  font-weight: 500;
}

/* RESPONSIVE */
@media (min-width: 768px) {
  .skills-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .skills-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
</style>