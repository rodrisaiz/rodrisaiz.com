---
const { tools = [], speedMs = 100000 } = Astro.props;
---

<section class="skills">

  <h1 class="skills-title">SKILLS</h1>
  <div class="skills-mask">
    <div class="skills-track-wrapper">
      
  <div class="skills-track">

      {[...tools, ...tools].map((tool) => (
        <div class="skill-item">

          <div class="skill-logo-wrapper">
            <img
              src={tool.logo}
              alt={tool.name}
              width="40"
              height="40"
              class="skill-logo"
              loading="lazy"
            />        
          </div>

          <span class="skill-tooltip">
            {tool.name}
          </span>
        
        </div>
      ))}

    </div>

  </div>
</section>

<style>
  .skills-title {
  text-align: center;
  font-size: 4.5rem;
  font-weight: 800;
  letter-spacing: 3px;

  margin-bottom: 6rem;

  background: linear-gradient(90deg, #ffffff, #a1a1a1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}


  .skills {
    overflow: hidden;
    position: relative;
    z-index: 10;
    margin: auto;
    padding: 1rem 2rem;
    width: 100%;
     margin-bottom: 2rem;
  }

  .skills-mask {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );

    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .skills-track {
    display: flex;
    width: max-content;
    will-change: transform;
    transform: translateX(0);
    animation: skills-scroll var(--speed, 100000ms) linear infinite;
  }

  .skill-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    min-width: 160px;
    margin: 0 1rem;
    padding: 1.5rem;

    border-radius: 12px;

    transition: transform 0.3s ease;
  }

  .skill-logo-wrapper {

    width: 45px;
    height: 45px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 0.5rem;
  }

  .skill-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;

    transition: transform 0.3s ease;

    filter: grayscale(1);
    opacity: 0.8;
  }

  .skill-item:hover .skill-logo {
    transform: scale(1.1);
    filter: grayscale(0);
    opacity: 1;
  }

  .skill-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted, #b0b0b0);

    transition: color 0.3s ease;
  }

  @keyframes skills-scroll {
    0% {
      transform: translateX(-20%);
    }

    100% {
      transform: translateX(-70%);
    }
  }

  @media (min-width: 768px) {
    .skill-item {
      min-width: 180px;
    }
  }

.skills-track {
  display: flex;
  width: max-content;
  will-change: transform;
  transform: translateX(0);
}

.skill-item:hover ~ .skills-track {
  animation-play-state: paused;
}

.skill-tooltip {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--color-text-muted, #b0b0b0);

  opacity: 0;
  transform: translateY(8px);
  transition: all 0.25s ease;

  margin-top: 0.5rem;
  pointer-events: none;
}

.skill-item:hover .skill-tooltip {
  opacity: 1;
  transform: translateY(0);
}
.skill-item {
  transition: transform 0.3s ease;
}

.skill-item:hover {
  transform: scale(1.20);
}
</style>